@model CRMWebConsole.Domain.Bank

<div class="modal fade" id="modal-bank" tabindex="-1" aria-labelledby="bankModalLabel" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                @if (Model.Id > 0)
                {
                    <h5 class="modal-title fs-5" id="bankModalLabel">Edit Bank</h5>
                }
                else
                {
                    <h5 class="modal-title fs-5" id="brokerModalLabel">Add Bank</h5>
                }
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">×</span></button>
            </div>
            <div class="modal-body">
                @Html.HiddenFor(m => m.Id)

                <div class="row mb-2">
                    <div class="col">
                        <label>Name <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.Name, new { @class = "form-control", placeholder = "Enter Name" })
                        <span class="text-danger"></span>
                    </div>
                    <div class="col">
                        <label>Account Type <span class="text-danger">*</span></label>
                        @Html.DropDownListFor(m => m.AccountType, ViewBag.AccountTypes as List<SelectListItem>, "Select Account Type", new { @class = "form-control" })
                        <span class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-2">
                    <div class="col">
                        <label>Account Number <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.AccountNumber, new { @class = "form-control", placeholder = "Enter Account Number" })
                        <span class="text-danger"></span>
                    </div>
                    <div class="col">
                        <label>Branch Name <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.BranchName, new { @class = "form-control", placeholder = "Enter Branch Name" })
                        <span class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-2">
                    <div class="col">
                        <label>IFSCode <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.IFSCode, new { @class = "form-control", placeholder = "Enter IFSCode" })
                        <span class="text-danger"></span>
                    </div>
                    <div class="col">
                        <label>UPI </label>
                        @Html.TextBoxFor(m => m.UPI, new { @class = "form-control", placeholder = "Enter UPI Id" })
                    </div>
                </div>

                <div class="row mb-2">
                    <div class="col">
                        <div class="form-check">
                            @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input" })
                            <label class="form-check-label" for="isActiveCheck">Is Active?</label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <a href="javascript:void(0);" class="btn btn-primary btn-submit">Submit</a>
            </div>
        </div>
    </div>
</div>

<script src="@Url.Content("~/custom-js/bank/create.js")"></script>

@Html.Hidden("NotificationType", (object)ViewBag.NotificationType)
@Html.Hidden("NotificationMsg", (object)ViewBag.NotificationMsg)
