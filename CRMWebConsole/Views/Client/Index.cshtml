@model CRMWebConsole.Domain.ClientLister
@{
    ViewBag.Title = "Client";
}

<div class="content-wrapper">
    <!-- Content Header (Page header) -->
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Dashboard")">Home</a></li>
                        <li class="breadcrumb-item active">Client</li>
                    </ol>
                </div>
            </div>
        </div><!-- /.container-fluid -->
    </section>

    <!-- Main content -->
    <section class="content">
        <!-- Default box -->
        <div class="card">
            @using (Ajax.BeginForm("List", "Client", new AjaxOptions() { UpdateTargetId = "divList", InsertionMode = InsertionMode.Replace, LoadingElementId = "loading-element" }, new { @id = "frmList" }))
            {
                <div id="divList">
                    @Html.Action("List", Model)
                </div>
            }
        </div>
        <!-- /.card -->
        <!-- Default box -->
        <div class="card">
            @using (Ajax.BeginForm("SaveClient", "Client", new AjaxOptions() { UpdateTargetId = "divClient", InsertionMode = InsertionMode.Replace, LoadingElementId = "loading-element" }, new { @id = "frmSaveClient" }))
            {
                <div id="divClient"></div>
            }
        </div>
        <div class="card">
            @using (Ajax.BeginForm("SaveAddress", "Client", new AjaxOptions() { UpdateTargetId = "divAddress", InsertionMode = InsertionMode.Replace, LoadingElementId = "loading-element" }, new { @id = "frmSaveAddress" }))
            {
                <div id="divAddress"></div>
            }
        </div>

        <div class="card">
            @using (Ajax.BeginForm("SavePhoneNumber", "Client", new AjaxOptions() { UpdateTargetId = "divPhoneNumber", InsertionMode = InsertionMode.Replace, LoadingElementId = "loading-element" }, new { @id = "frmSavePhoneNumber" }))
            {
                <div id="divPhoneNumber"></div>
            }
        </div>
        <!-- /.card -->
    </section>
    <!-- /.content -->
</div>

