@model List<CRMWebConsole.Domain.ReceiptAllocation>

<div class="card-body">
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>
                    Invoice Number
                </th>
                <th>
                    Net Amount
                </th>
                <th>
                    Amount Paid
                </th>
                <th>
                    Amount Due
                </th>
                <th>
                    Status
                </th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model != null && Model.Count > default(int))
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @item.InvoiceNumber
                        </td>
                        <td>
                            @item.NetAmount
                        </td>
                        <td>
                            @item.Amount
                        </td>
                        <td>
                            @item.AmountDue
                        </td>
                        <td>
                            @item.Status
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td class="text-center text-danger" colspan="5">
                        There is currently no content to display
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

