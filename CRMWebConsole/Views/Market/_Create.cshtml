@model CRMWebConsole.Domain.Market

<div class="modal fade" id="modal-market" tabindex="-1" aria-labelledby="brokerModalLabel" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                @if (Model.Id > 0)
                {
                    <h5 class="modal-title fs-5" id="brokerModalLabel">Edit Market</h5>
                }
                else
                {
                    <h5 class="modal-title fs-5" id="brokerModalLabel">Add Market</h5>
                }
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">×</span></button>
            </div>
            <div class="modal-body">
                @Html.HiddenFor(m => m.Id)
                <div class="row mb-2">
                    <div class="col">
                        <label>Name <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.Name, new { @class = "form-control", placeholder = "Enter Name" })
                        <span class="text-danger"></span>
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col">
                        <label>Line 1 <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.Line1, new { @class = "form-control", placeholder = "Enter Line 1" })
                        <span class="text-danger"></span>
                    </div>
                    <div class="col">
                        <label>Line 2</label>
                        @Html.TextBoxFor(m => m.Line2, new { @class = "form-control", placeholder = "Enter Line 2" })
                        <span class="text-danger"></span>
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col">
                        <label>City <span class="text-danger">*</span></label>
                        <select name="@Html.NameFor(m => m.City)" id="@Html.IdFor(m => m.City)" class="form-control">
                            <option>Select City</option>
                            @if (ViewBag.Cities != null)
                            {
                                foreach (var item in ViewBag.Cities)
                                {
                                    if (item.Selected)
                                    {
                                        <option value="@item.Value" selected>@item.Text</option>
                                    }
                                    else
                                    {
                                        <option value="@item.Value">@item.Text</option>
                                    }
                                }
                            }
                        </select>
                        <span class="text-danger"></span>
                    </div>

                    <div class="col">
                        <label>State <span class="text-danger">*</span></label>
                        @Html.DropDownListFor(m => m.State, ViewBag.States as List<SelectListItem>, "Select State", new { @class = "form-control" })
                        <span class="text-danger"></span>
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col">
                        <label>Zip Code <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.ZipCode, new { @class = "form-control", placeholder = "Enter Zip Code" })
                        <span class="text-danger"></span>
                    </div>
                    <div class="col">
                        <label>Rank <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.Rank, new { @class = "form-control", placeholder = "Enter Rank" })
                        <span class="text-danger"></span>
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col">
                        <span class="text-info">*Select a state first to display available cities.</span>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <a href="javascript:void(0);" class="btn btn-primary btn-submit">Submit</a>
            </div>
        </div>
    </div>
</div>

<script src="@Url.Content("~/custom-js/market/create.js")"></script>

@Html.Hidden("NotificationType", (object)ViewBag.NotificationType)
@Html.Hidden("NotificationMsg", (object)ViewBag.NotificationMsg)