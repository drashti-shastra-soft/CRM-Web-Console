@model List<CRMWebConsole.Domain.InvoiceLineItem>

<div class="card-body">
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>
                    Item Name
                </th>
                <th>
                    Style
                </th>
                <th>
                    Lot Number
                </th>
                <th>
                    Grey Meter
                </th>
                <th>
                    Piece
                </th>
                <th>
                    Part Piece
                </th>
                <th>
                    Grey Value
                </th>
                <th>
                    Finish Meter
                </th>
                <th>
                    Shortage
                </th>
                <th>
                    Rate
                </th>
                <th>
                    Amount
                </th>
                <th>
                    Add To Total
                </th>
                <th>
                    Subtract From Total
                </th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model != null && Model.Count > default(int))
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @item.ItemName
                        </td>
                        <td>
                            @item.Style
                        </td>
                        <td>
                            @item.LotNumber
                        </td>
                        <td>
                            @item.GreyMeter
                        </td>
                        <td>
                            @item.Piece
                        </td>
                        <td>
                            @item.PartPiece
                        </td>
                        <td>
                            @item.GreyValue
                        </td>
                        <td>
                            @item.FinishMeter
                        </td>
                        <td>
                            @item.Shortage
                        </td>
                        <td>
                            @item.Rate
                        </td>
                        <td>
                            @item.Amount
                        </td>
                        <td>
                            @item.AddToTotal
                        </td>
                        <td>
                            @item.SubtractFromTotal
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td class="text-center text-danger" colspan="13">
                        There is currently no content to display
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>