@model CRMWebConsole.Domain.InvoiceLister

<div class="card-header">
    <a href="@Url.Action("Import", "Invoice")" class="btn btn-success float-right">Import Invoice</a>
</div>

<div class="card-body">
    <table id="tblImportInvoice" class="table table-bordered">
        <thead>
            <tr>
                <th></th>
                <th>
                    Date
                </th>
                <th>
                    Client Name
                </th>
                <th>
                    Invoice Number
                </th>
                <th>
                    Challan Number
                </th>
                <th>
                    LR Number
                </th>
                <th>
                    Vehicle Number
                </th>
                <th>
                    Dyeing Supervisor
                </th>
                <th>
                    Collection Agent
                </th>
                <th>
                    Broker
                </th>
                <th>
                    Taxable Value
                </th>
                <th>
                    SGST
                </th>
                <th>
                    CGST
                </th>
                <th>
                    IGST
                </th>
                <th>
                    Net Amount
                </th>                
                <th class="text-center">
                    Action
                </th>
            </tr>
            <tr>
                <th></th>
                <th>
                    @Html.TextBoxFor(m => m.SearchCriteria.ClientName, new { @class = "form-control search-text" })
                </th>
                <th>
                    @Html.TextBoxFor(m => m.SearchCriteria.InvoiceNumber, new { @class = "form-control search-text" })
                </th>
                <th>
                    @Html.TextBoxFor(m => m.SearchCriteria.ChallanNumber, new { @class = "form-control search-text" })
                </th>
                <th>
                    @Html.TextBoxFor(m => m.SearchCriteria.LRNumber, new { @class = "form-control search-text" })
                </th>
                <th>
                    @Html.TextBoxFor(m => m.SearchCriteria.VehicleNumber, new { @class = "form-control search-text" })
                </th>
                <th>
                    @Html.TextBoxFor(m => m.SearchCriteria.DyeingSupervisorName, new { @class = "form-control search-text" })
                </th>
                <th>
                    @Html.TextBoxFor(m => m.SearchCriteria.CollectionAgentName, new { @class = "form-control search-text" })
                </th>
                <th>
                    @Html.TextBoxFor(m => m.SearchCriteria.BrokerName, new { @class = "form-control search-text" })
                </th>
                <th class="text-center"></th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.List != null && Model.List.Count > default(int))
            {
                foreach (var item in Model.List)
                {
                    var rowId = $"row_{item.Id}";
                    <tr id="@rowId">
                        <td class="text-center align-middle">
                            <a href="javascript:void(0);" data-id="@item.Id" class="toggle-child">
                                <i class="fas fa-plus"></i>
                            </a>
                        </td>
                        <td>@item.Date.ToString("dd-MM-yyyy")</td>
                        <td>@item.ClientName</td>
                        <td>@item.InvoiceNumber</td>
                        <td>@item.ChallanNumber</td>
                        <td>@item.LRNumber</td>
                        <td>@item.VehicleNumber</td>
                        <td>@item.DyeingSupervisorName</td>
                        <td>@item.CollectionAgentName</td>
                        <td>@item.BrokerName</td>
                        <td>@item.TaxableValue</td>
                        <td>@item.SGST</td>
                        <td>@item.CGST</td>
                        <td>@item.IGST</td>
                        <td>@item.NetAmount</td>
                        <td class="text-center">
                            <a href="javascript:void(0);" data-id="@item.Id" class="icon-delete text-danger"><i class="fas fa-trash"></i></a>
                        </td>
                    </tr>
                    <tr id="child_@item.Id" class="child-row" style="display:none;">
                        <td colspan="16" style="padding:20px;">
                            <div id="childContent_@item.Id">

                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td class="text-center text-danger" colspan="16">
                        There is currently no content to display
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- /.card-body -->
<div class="card-footer">
    <div class="row">
        <div class="col-12">
            <div class="row footer-button-section">
                <div class="col-lg-3 col-xl-3">
                    <div class="page-per-size d-flex align-items-center">
                        @Html.DropDownListFor(m => m.Pagination.PageSize, ViewBag.Pagination as List<SelectListItem> ?? new List<SelectListItem>(), new { @class = "form-control search-pagination set-page-size" })
                        <label>entries per page</label>
                    </div>
                </div>
                <style>
                </style>
                <div class="col-lg-4 offset-xl-1 col-xl-3 d-flex justify-content-center align-items-center">
                    <div class="showing-entry d-flex align-items-center">
                        <h3>@Model.Pagination.PaginationSummary </h3>
                    </div>
                </div>
                <div class="col-lg-5 col-xl-5">
                    <div class="navigation-tab">
                        <input type="button" value="First" class="btn btn-secondary navigation" data-direction="First" />
                        <input type="button" value="Previous" class="btn btn-secondary navigation" data-direction="Previous" />
                        <label> @Model.Pagination.CurrentPage / @Model.Pagination.TotalPage</label>
                        <input type="button" value="Next" class="btn btn-secondary navigation" data-direction="Next" />
                        <input type="button" value="Last" class="btn btn-secondary navigation" data-direction="Last" />
                    </div>
                </div>
            </div>
        </div>
    </div>
    @Html.HiddenFor(m => m.Pagination.Skip)
    @Html.HiddenFor(m => m.Pagination.TotalRecord)
</div>
<!-- /.card-footer-->

<script src="@Url.Content("~/custom-js/invoice/list.js")"></script>
<script>
    window.paginationConfig = {
        pageSize: @Model.Pagination.PageSize,
        totalPage: @Model.Pagination.TotalPage,
        currentPage: @Model.Pagination.CurrentPage,
        skip: @Model.Pagination.Skip
    };
</script>

