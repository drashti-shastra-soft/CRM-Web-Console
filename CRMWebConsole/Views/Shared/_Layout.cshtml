<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title | CRM</title>

    <!-- Google Font: Source Sans Pro -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="@Url.Content("~/Content/pluggins/fontawesome/all.min.css")" />

    <!-- Toastr -->
    <link rel="stylesheet" href="@Url.Content("~/Scripts/plugins/toastr/toastr.min.css")" />

    <!-- Theme style -->
    <link rel="stylesheet" href="@Url.Content("~/Content/dist/adminlte.min.css")">

    <!-- Custom -->
    <link rel="stylesheet" href="@Url.Content("~/Content/css/custom.css")" />

    <!-- jQuery -->
    <script src="@Url.Content("~/Scripts/plugins/jquery/jquery.min.js")"></script>

    <!-- Bootstrap 4 -->
    <script src="@Url.Content("~/Scripts/plugins/bootstrap/bootstrap.bundle.min.js")"></script>

    <!-- Toastr -->
    <script src="@Url.Content("~/Scripts/plugins/toastr/toastr.min.js")"></script>

    <!-- AdminLTE App -->
    <script src="@Url.Content("~/Scripts/dist/js/adminlte.min.js")"></script>

    <!-- Unobtrusive -->
    <script src="@Url.Content("~/Scripts/jquery.unobtrusive-ajax.min.js")"></script>

    <!-- Masking -->
    <script src="@Url.Content("~/Scripts/jquery.mask.min.js")"></script>

    <!-- Custom Notification -->
    <script src="@Url.Content("~/custom-js/layout/custom-notification.js")"></script>

    <!-- Custom Functions -->
    <script src="@Url.Content("~/custom-js/layout/custom-functions.js")"></script>
</head>
<body class="hold-transition sidebar-mini">
    <!-- Site wrapper -->
    <div class="wrapper">
        <!-- Navbar -->
        <nav class="main-header navbar navbar-expand navbar-white navbar-light">
            <!-- Right navbar links -->
            <ul class="navbar-nav ml-auto">
                <li class="nav-item">
                    <a class="nav-link" data-widget="fullscreen" href="#" role="button">
                        <i class="fas fa-expand-arrows-alt"></i>
                    </a>
                </li>
            </ul>
        </nav>
        <!-- /.navbar -->
        <!-- Main Sidebar Container -->
        <aside class="main-sidebar sidebar-dark-primary elevation-4">
            <!-- Brand Logo -->
            <a href="@Url.Action("Index", "Dashboard")" class="brand-link">
                <img src="@Url.Content("~/Content/assets/img/AdminLTELogo.png")" alt="CRM" class="brand-image img-circle elevation-3" style="opacity: .8">
                <span class="brand-text font-weight-light">CRM</span>
            </a>

            <!-- Sidebar -->
            <div class="sidebar">
                <!-- Sidebar user (optional) -->
                <!-- Sidebar Menu -->
                <nav class="mt-2">
                    <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
                        <li class="nav-item">
                            <a href="@Url.Action("Index", "Dashboard")" class="nav-link" @(ViewBag.Title == "Dashboard" ? "active" : "")>
                                <i class="nav-icon fas fa-tachometer-alt"></i>
                                <p>
                                    Dashboard
                                </p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a href="#" class="nav-link">
                                <i class="nav-icon fas fa-chart-pie"></i>
                                <p>
                                    Master
                                    <i class="right fas fa-angle-left"></i>
                                </p>
                            </a>
                            <ul class="nav nav-treeview">
                                <li class="nav-item">
                                    <a href="@Url.Action("Index", "State")" class="nav-link @(ViewBag.Title == "State" ? "active" : "")">
                                        <i class="nav-icon fas fa-flag"></i>
                                        <p>State</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="@Url.Action("Index", "City")" class="nav-link @(ViewBag.Title == "City" ? "active" : "")">
                                        <i class="nav-icon fas fa-city"></i>
                                        <p>City</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="@Url.Action("Index", "Market")" class="nav-link @(ViewBag.Title == "City" ? "Market" : "")">
                                        <i class="nav-icon fas fa-store-alt"></i>
                                        <p>Market</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="@Url.Action("Index", "Bank")" class="nav-link @(ViewBag.Title == "Invoice" ? "active" : "")">
                                        <i class="nav-icon fas fa-piggy-bank"></i>
                                        <p>Bank</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="@Url.Action("Index", "Item")" class="nav-link @(ViewBag.Title == "Item" ? "active" : "")">
                                        <i class="nav-icon fas fa-box-open"></i>
                                        <p>Item</p>
                                    </a>
                                </li>
                            </ul>
                        </li>

                        <li class="nav-item">
                            <a href="@Url.Action("Index", "User")" class="nav-link @(ViewBag.Title == "User" ? "active" : "")">
                                <i class="nav-icon fas fa-user-circle"></i>
                                <p>User</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="@Url.Action("Index", "Broker")" class="nav-link @(ViewBag.Title == "Broker" ? "active" : "")">
                                <i class="nav-icon fas fa-handshake"></i>
                                <p>Broker</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="@Url.Action("Index", "Client")" class="nav-link @(ViewBag.Title == "Client" ? "active" : "")">
                                <i class="nav-icon far fa-building"></i>
                                <p>Client</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a href="@Url.Action("Index", "Invoice")" class="nav-link @(ViewBag.Title == "Invoice" ? "active" : "")">
                                <i class="nav-icon fas fa-file-invoice"></i>
                                <p>Invoice</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="@Url.Action("Index", "Receipt")" class="nav-link @(ViewBag.Title == "Receipt" ? "active" : "")">
                                <i class="nav-icon fas fa-store"></i>
                                <p>Receipt</p>
                            </a>
                        </li>

                        @{
                            bool isReportActive = ViewBag.Title == "SalesReport" || ViewBag.Title == "Outstanding" || ViewBag.Title == "SalesReceipt";
                        }

                        <li class="nav-item @(isReportActive ? "menu-open" : "")">
                            <a href="#" class="nav-link @(isReportActive ? "active" : "")">
                                <i class="nav-icon fas fa-file-alt"></i>
                                <p>
                                    Reports
                                    <i class="right fas fa-angle-left"></i>
                                </p>
                            </a>

                            <ul class="nav nav-treeview" style="display: @(isReportActive ? "block" : "none")">
                                <li class="nav-item">
                                    <a href="@Url.Action("Index", "SalesReport")" class="nav-link @(ViewBag.Title == "SalesReport" ? "active" : "")">
                                        <i class="nav-icon fas fa-chart-line"></i>
                                        <p>Sales</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="@Url.Action("Index", "Outstanding")" class="nav-link @(ViewBag.Title == "Outstanding" ? "active" : "")">
                                        <i class="nav-icon fas fa-file-invoice-dollar"></i>
                                        <p>Outstanding</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="@Url.Action("Index", "SalesReceipt")" class="nav-link @(ViewBag.Title == "SalesReceipt" ? "active" : "")">
                                        <i class="nav-icon fas fa-money-check-alt"></i>
                                        <p>Receipt</p>
                                    </a>
                                </li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a href="@Url.Action("Index", "ChangePassword")" class="nav-link @(ViewBag.Title == "ChangePassword" ? "active" : "")">
                                <i class="nav-icon fas fa-unlock-alt"></i>
                                <p>
                                    Change Password
                                </p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="@Url.Action("Index", "Logout")" class="nav-link">
                                <i class="nav-icon fas fa-sign-out-alt"></i>
                                <p>
                                    Logout
                                </p>
                            </a>
                        </li>
                    </ul>
                </nav>
                <!-- /.sidebar-menu -->
            </div>
            <!-- /.sidebar -->
        </aside>

        @RenderBody()

        <div id="loading-element" class="custom-loader">
            <div class="loader">
                <img src="@Url.Content("~/Content/assets/img/Admin/Loading.gif")" style="height:100px;" />
            </div>
            <br />
        </div>

        <footer class="main-footer">
            <div class="float-right d-none d-sm-block">
                <b>Version</b> 1.0.0
            </div>
            <strong>Copyright &copy; 2025-2026 <a href="javascript:void(0)">CRM</a>.</strong> All rights reserved.
        </footer>

        <!-- Control Sidebar -->
        <aside class="control-sidebar control-sidebar-dark">
            <!-- Control sidebar content goes here -->
        </aside>
        <!-- /.control-sidebar -->
    </div>
    <!-- ./wrapper -->


</body>
</html>

